<mujoco model="contact_deflection">
  <compiler angle="radian" autolimits="true"
            meshdir="../../third_party/space_robot_env/assets/stls"/>
  <option timestep="0.001" gravity="0 0 0" integrator="implicitfast"/>
  <visual><global offwidth="640" offheight="480"/></visual>
  <default>
    <joint damping="0.25" armature="0.03"/>
    <geom condim="3" friction="0.6 0.01 0.001"
          solref="0.01 0.1" solimp="0.98 0.995 0.0005 0.5 2"/>
    <motor ctrllimited="true"/>
    <default class="arm1"><joint damping="0.25"/></default>
    <default class="arm2"><joint damping="0.25"/></default>
  </default>
  <asset>
    <material name="bus_mat" rgba="0.25 0.3 0.38 1"/>
    <material name="solar_mat" rgba="0.035 0.16 0.42 1"
              specular="0.45" shininess="0.65"/>
    <material name="solar_frame_mat" rgba="0.55 0.60 0.68 1"/>
    <material name="shield_mat" rgba="0.15 0.55 0.85 1"/>
    <material name="projectile_mat" rgba="0.9 0.25 0.12 1"/>
    <mesh name="v_base" file="v_base.stl"/>
    <mesh name="v_shoulder" file="v_shoulder.stl"/>
    <mesh name="v_upperarm" file="v_upperarm.stl"/>
    <mesh name="v_forearm" file="v_forearm.stl"/>
    <mesh name="v_wrist1" file="v_wrist1.stl"/>
    <mesh name="v_wrist2" file="v_wrist2.stl"/>
    <mesh name="v_wrist3" file="v_wrist3.stl"/>
  </asset>
  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1"/>
    <camera name="overview" pos="4 -6 3"
            xyaxes="0.83 0.55 0 -0.22 0.33 0.92"/>
    <camera name="reverse_overview" pos="-4 6 3"
            xyaxes="-0.83 -0.55 0 0.22 -0.33 0.92"/>
    <body name="spacecraft_bus" pos="0 0 0">
      <freejoint name="spacecraft_free"/>
      <!-- Preserve the original 200 kg, 1.7452 m-cube inertia while using a
           smaller visual/collision bus. Solar hardware below is visual-only. -->
      <inertial pos="0 0 0" mass="200"
                diaginertia="101.5241013 101.5241013 101.5241013"/>
      <geom name="bus" type="box" size="0.60 0.60 0.60"
            mass="0" material="bus_mat"/>
      <geom name="solar_boom_left" type="box" pos="-0.685 0 0"
            size="0.085 0.025 0.025" mass="0" group="2"
            contype="0" conaffinity="0" material="solar_frame_mat"/>
      <geom name="solar_left_panel" type="box" pos="-1.91 0 0"
            size="1.14 0.025 0.35" mass="0" group="2"
            contype="0" conaffinity="0" material="solar_mat"/>
      <geom name="solar_boom_right" type="box" pos="0.685 0 0"
            size="0.085 0.025 0.025" mass="0" group="2"
            contype="0" conaffinity="0" material="solar_frame_mat"/>
      <geom name="solar_right_panel" type="box" pos="1.91 0 0"
            size="1.14 0.025 0.35" mass="0" group="2"
            contype="0" conaffinity="0" material="solar_mat"/>
      <body name="manipulator_mount" pos="0 0.60 0"
            euler="-1.57079632679 0 0">
        <geom name="mount" mass="10" pos="0 0 -0.04"
              size="0.1 0.1 0.04" type="box" material="bus_mat"/>
        <include file="space_robot_ur5.xml"/>
      </body>
    </body>
    <body name="projectile" pos="0 -2 1.7">
      <freejoint name="projectile_free"/>
      <geom name="projectile_geom" type="sphere" size="0.1"
            mass="1.5" material="projectile_mat"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_pan_motor" joint="arm:shoulder_pan_joint"
           gear="1" ctrlrange="-250 250"/>
    <motor name="shoulder_lift_motor" joint="arm:shoulder_lift_joint"
           gear="1" ctrlrange="-250 250"/>
    <motor name="elbow_motor" joint="arm:elbow_joint"
           gear="1" ctrlrange="-200 200"/>
    <motor name="wrist_1_motor" joint="arm:wrist_1_joint"
           gear="1" ctrlrange="-50 50"/>
    <motor name="wrist_2_motor" joint="arm:wrist_2_joint"
           gear="1" ctrlrange="-50 50"/>
    <motor name="wrist_3_motor" joint="arm:wrist_3_joint"
           gear="1" ctrlrange="-50 50"/>
  </actuator>
</mujoco>
